# Copy to .env (or set in Cloudflare Pages → Settings → Variables). Read at build time.
# Anything left empty shows an obvious placeholder, and the build prints a warning.

PUBLIC_STRIPE_LINK=          # https://buy.stripe.com/...
PUBLIC_PAYPAL_ME=            # just the handle: paypal.me/<this>

PUBLIC_IBAN_HOLDER=
PUBLIC_IBAN=                 # spaces optional, it gets grouped for display
PUBLIC_IBAN_BANK=
PUBLIC_IBAN_BIC=
PUBLIC_IBAN_CURRENCY=        # e.g. RON, EUR

PUBLIC_WALLET_EVM=           # 0x...
PUBLIC_EVM_NETWORKS=         # e.g. Ethereum, Base, Arbitrum
PUBLIC_WALLET_SOL=
PUBLIC_WALLET_BTC=           # bc1...

PUBLIC_GA_ID=            # Google Analytics measurement id, G-XXXXXXX. Empty = no analytics at all.
