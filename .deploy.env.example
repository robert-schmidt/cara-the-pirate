# Where `npm run deploy` publishes. Copy to .deploy.env and fill in — .deploy.env stays out of git.
HOST=deploy@example.com        # ssh user@host
PORT=22                        # ssh port
DEST=/home/<account>/web/<domain>/public_html/
BLOG_DEST=/home/<account>/blog/app/
BLOG_SERVICE=<systemd-unit>    # restarted after the blog code changes
OWNER=<account>                # files are chowned to this user:group
SITE_URL=https://example.com
SHORT_URL=https://example.net  # short domain that redirects to SITE_URL (optional)
