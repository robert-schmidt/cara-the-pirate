---
import { t, type Lang } from '../i18n';
import { social } from '../site';

const { lang } = Astro.props as { lang: Lang };
const s = t[lang];
const home = lang === 'en' ? '/' : '/ro/';
const otherHome = lang === 'en' ? '/ro/' : '/';
const title = 'Cara the Pirate';
---

<header class="bar">
  <a class="brand" href={home}>
    <svg viewBox="0 0 40 20" width="34" height="17" aria-hidden="true">
      <circle cx="10" cy="10" r="6.5" fill="#c47a3a" stroke="currentColor" stroke-width="2.4"></circle>
      <circle cx="10" cy="10" r="2.6" fill="currentColor"></circle>
      <path d="M24 8.5 Q30.5 15.5 37 8.5" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"></path>
    </svg>
    {title}
  </a>
  <nav>
    <a class="social" href={social.x} aria-label={`Cara on X, ${social.xHandle}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 1.5h3.6l-7.9 9 9.3 12.3h-7.3l-5.7-7.5-6.5 7.5H.8l8.4-9.7L.5 1.5h7.5l5.2 6.8 5.7-6.8Zm-1.3 19.1h2L7.3 3.4H5.2l12.4 17.2Z"></path></svg>
    </a>
    <a class="social" href={social.tiktok} aria-label={`Cara on TikTok, ${social.tiktokHandle}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.6 5.8A4.3 4.3 0 0 1 15.5 3h-3.1v12.4a2.6 2.6 0 1 1-1.8-2.5V9.7a5.7 5.7 0 1 0 4.9 5.6V9a7.4 7.4 0 0 0 4.3 1.4V7.3a4.3 4.3 0 0 1-3.2-1.5Z"></path></svg>
    </a>
    <a class="social" href={social.instagram} aria-label={`Cara on Instagram, ${social.instagramHandle}`}>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.05 1.8.25 2.2.42.6.22 1 .48 1.4.9.43.42.7.82.92 1.4.17.42.37 1.06.42 2.24.06 1.28.07 1.66.07 4.88s-.01 3.6-.07 4.88c-.05 1.18-.25 1.82-.42 2.24-.22.58-.49.98-.91 1.4-.42.42-.82.68-1.4.9-.42.17-1.07.37-2.25.42-1.28.06-1.66.07-4.88.07s-3.6 0-4.88-.07c-1.18-.05-1.83-.25-2.25-.42-.58-.22-.98-.48-1.4-.9-.42-.42-.69-.82-.91-1.4-.17-.42-.37-1.06-.42-2.24C2.2 15.6 2.2 15.22 2.2 12s0-3.6.07-4.88c.05-1.18.25-1.82.42-2.24.22-.58.49-.98.91-1.4.42-.42.82-.68 1.4-.9.42-.17 1.07-.37 2.25-.42C8.53 2.2 8.9 2.2 12 2.2Zm0 1.98c-3.15 0-3.5.01-4.74.07-1.14.05-1.76.24-2.17.4-.55.21-.94.47-1.35.88-.41.41-.67.8-.88 1.35-.16.41-.35 1.03-.4 2.17-.06 1.24-.07 1.6-.07 4.74s.01 3.5.07 4.74c.05 1.14.24 1.76.4 2.17.21.55.47.94.88 1.35.41.41.8.67 1.35.88.41.16 1.03.35 2.17.4 1.24.06 1.6.07 4.74.07s3.5-.01 4.74-.07c1.14-.05 1.76-.24 2.17-.4.55-.21.94-.47 1.35-.88.41-.41.67-.8.88-1.35.16-.41.35-1.03.4-2.17.06-1.24.07-1.6.07-4.74s-.01-3.5-.07-4.74c-.05-1.14-.24-1.76-.4-2.17a3.6 3.6 0 0 0-.88-1.35 3.6 3.6 0 0 0-1.35-.88c-.41-.16-1.03-.35-2.17-.4-1.24-.06-1.6-.07-4.74-.07Zm0 3.37a5.45 5.45 0 1 1 0 10.9 5.45 5.45 0 0 1 0-10.9Zm0 1.98a3.47 3.47 0 1 0 0 6.94 3.47 3.47 0 0 0 0-6.94Zm5.67-3.5a1.27 1.27 0 1 1 0 2.55 1.27 1.27 0 0 1 0-2.55Z"></path></svg>
</a>
<a class="nav-blog" href="/blog">{s.nav.blog}</a>
<a href={otherHome} hreflang={lang === 'en' ? 'ro' : 'en'} lang={lang === 'en' ? 'ro' : 'en'}>
      <span class="lang-full">{s.nav.other}</span><span class="lang-short">{lang === 'en' ? 'RO' : 'EN'}</span>
    </a>
    <a class="btn small" href="#donate">{s.nav.donate}</a>
  </nav>
</header>
